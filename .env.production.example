# SoftLadyLux PRODUCTION environment. Copy to backend/.env on the server and fill in every
# REPLACE_ME. Never commit .env. The db, backend, worker, and backup containers read this file.
# The app refuses to start while a value is unsafe (apps/core/envcheck.py).

DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=false
# 1 = migrate, create the cache table, and collect static files on backend start
RUN_MIGRATIONS=1

# Long random secret. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_with_a_64_char_random_value

# Your real domain(s), comma separated, no scheme. Never '*'. (The internal names backend, localhost
# and 127.0.0.1 are always allowed in production for the frontend's server-side calls and healthchecks.)
ALLOWED_HOSTS=REPLACE_ME.example.com
# The https origin(s) users visit (needed for CSRF on admin and account forms).
CSRF_TRUSTED_ORIGINS=https://REPLACE_ME.example.com
# Same-origin behind nginx, so CORS stays empty.
CORS_ALLOWED_ORIGINS=

# Obscure path of the developer-only Django admin (served under /api/<ADMIN_URL>/). 12+ characters.
ADMIN_URL=REPLACE_ME_unguessable_path

# --- Database (the db service reads POSTGRES_*; the app reads DATABASE_URL) -------------------------
POSTGRES_DB=softladylux
POSTGRES_USER=softladylux
POSTGRES_PASSWORD=REPLACE_ME_database_password
DATABASE_URL=postgres://softladylux:REPLACE_ME_database_password@db:5432/softladylux

# --- HTTPS / cookies ---------------------------------------------------------------------------
COOKIE_SECURE=true
SSL_REDIRECT=true
HSTS_SECONDS=31536000
JWT_ACCESS_MINUTES=15

# --- Gunicorn ----------------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Email (generic SMTP; SRS NTF-02). Without these no email is sent. ---------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SoftLadyLux <no-reply@REPLACE_ME.example.com>

# --- SMS (MiMSMS): API key, username, sender name and URL are set in Admin → Settings → SMS ----

# --- Backups (scripts/backup.sh; the optional `backup` compose service) -------------------------
BACKUP_DIR=/app/backups
MEDIA_DIR=/app/media
BACKUP_KEEP=14
