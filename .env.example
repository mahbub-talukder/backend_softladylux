# Copy to <project root>/.env (the folder holding backend/ and frontend/). Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Obscure path for the developer-only Django admin (served under /api/<ADMIN_URL>/)
ADMIN_URL=change-this-obscure-path

POSTGRES_DB=softladylux
POSTGRES_USER=softladylux
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://softladylux:change-me@db:5432/softladylux

# SMS provider: fake (logs the OTP only) | mimsms (added in M4)
SMS_PROVIDER=fake
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=

# CORS (comma-separated origins allowed to call the API with cookies)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# JWT cookies: set to true when served over HTTPS
COOKIE_SECURE=false
JWT_ACCESS_MINUTES=15

# Frontend (Nuxt) API base: server-side inside Docker, browser same-origin
NUXT_API_BASE_INTERNAL=http://backend:8000/api/v1
NUXT_PUBLIC_API_BASE=/api/v1
