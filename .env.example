# Copy to backend/.env. Never commit .env. The db, backend, and worker containers read this file.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Obscure path for the developer-only Django admin (served under /api/<ADMIN_URL>/)
ADMIN_URL=change-this-obscure-path
# 1 = migrate, create the cache table, and collect static files on container start
RUN_MIGRATIONS=1

POSTGRES_DB=softladylux
POSTGRES_USER=softladylux
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://softladylux:change-me@db:5432/softladylux

# SMS provider: fake (logs the OTP only) | mimsms (added in M4)
SMS_PROVIDER=fake
# Email (generic SMTP; console backend when EMAIL_BACKEND is unset)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=SoftLadyLux <no-reply@example.com>
# MiMSMS HTTP API details are not in the SRS: fill from your MiMSMS account documentation.
# MIMSMS_ENDPOINT=
# MIMSMS_METHOD=POST
# MIMSMS_PARAMS={"api_key":"<param name>","to":"<param name>","text":"<param name>","sender":"<param name>"}
# MIMSMS_SUCCESS_CONTAINS=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=

# CORS (comma-separated origins allowed to call the API with cookies)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT cookies: set to true when served over HTTPS
COOKIE_SECURE=false
JWT_ACCESS_MINUTES=15

# Backup script paths inside the container (scripts/backup.sh)
BACKUP_DIR=/app/backups
MEDIA_DIR=/app/media
BACKUP_KEEP=14
